{
  "compilerOptions": {
    /* JavaScript version to compile to */
    "target": "ES2020",

    /* Module system */
    "module": "ESNext",

    /* Explicitly define source and output structure */
    "rootDir": "src",
    "outDir": "dist",

    /* Strict type checking */
    "strict": true,
    "strictNullChecks": true,

    /* Improves compatibility with imports */
    "esModuleInterop": true
  },
  "include": ["src"]
}